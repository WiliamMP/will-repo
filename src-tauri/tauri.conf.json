{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "will-repo",
  "version": "0.1.0",
  "identifier": "com.will.repo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "will-repo",
        "width": 1200,
        "height": 760,
        "decorations": false,
        "minWidth": 900,
        "minHeight": 560,
        "label": "main",
        "visible": false
      },
      {
        "label": "splashscreen",
        "url": "splashscreen.html",
        "title": "will-repo",
        "width": 360,
        "height": 300,
        "center": true,
        "resizable": false,
        "decorations": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "WiliamMP",
    "shortDescription": "Cliente git com tema Neon",
    "longDescription": "Cliente git para Windows: histórico com grafo, stage por linha, merge e rebase com conflitos, pull requests do GitHub.",
    "copyright": "© 2026 WiliamMP",
    "category": "DeveloperTool",
    "windows": {
      "nsis": {
        "languages": [
          "PortugueseBR"
        ],
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "pt-BR"
      }
    }
  }
}
