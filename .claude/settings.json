{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo test:*)",
      "Bash(cargo check:*)",
      "Bash(cargo build:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo tree:*)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run e2e:*)",
      "Bash(npm run registry:*)",
      "Bash(npm ls:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest:*)",
      "Bash(npx wdio:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh release view:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(gh release create:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh secret:*)"
    ],
    "deny": [
      "Read(**/*.key)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
